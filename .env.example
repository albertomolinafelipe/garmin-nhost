# Enter this value in the dashboard at runtime. It is not a Vite build variable
# and must never be compiled into browser assets.
HASURA_GRAPHQL_ADMIN_SECRET=replace-with-a-long-random-secret

# Server-side credential used only by ondra when writing back to Hasura.
ONDRA_HASURA_GRAPHQL_ADMIN_SECRET=replace-with-the-same-hasura-admin-secret
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql

# Dedicated Hasura -> ondra shared secret. Keep it distinct from the admin secret.
# Set this in BOTH Hasura (for metadata header forwarding) and ondra (verification).
ONDRA_REMOTE_SCHEMA_SECRET=replace-with-an-independent-long-random-secret

# Hasura-side URL for the ondra GraphQL endpoint. It must be reachable from Hasura.
ONDRA_GRAPHQL_URL=http://ondra:8000/graphql

GARMIN_EMAIL=
GARMIN_PASSWORD=

# ondra validates all three server-side settings at startup:
# ONDRA_REMOTE_SCHEMA_SECRET, ONDRA_HASURA_GRAPHQL_ADMIN_SECRET, HASURA_GRAPHQL_URL.
